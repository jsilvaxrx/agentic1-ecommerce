# ---- Google GenAI ----
# API key de Google AI Studio: https://aistudio.google.com/apikey
# Es la que lee langchain-google-genai para autenticarse contra el modelo.
GOOGLE_API_KEY=


# Alias opcional aceptado por la librería (tiene menor prioridad que GOOGLE_API_KEY).
# Descoméntalo solo si usas esta en vez de GOOGLE_API_KEY.
# GEMINI_API_KEY=

# Nombre del modelo que usa el router (api/app.py y src/router/graph.py).
MODELO=gemini-3.5-flash-lite

# ---- Memoria persistente ----
# URL de Postgres local o la Config Var DATABASE_URL de Heroku. No uses esta credencial ficticia.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/ecommerce_router

# ---- API ----
# Clave para proteger POST /chat. Genera una propia, por ejemplo: openssl rand -hex 32
API_KEY=clave_de_ejemplo_no_usar_en_produccion

# ---- Telegram ----
# Token que entrega @BotFather al crear el bot. Vacío hasta la parte 5.
TELEGRAM_TOKEN=

# Secreto que Telegram manda en cada webhook (header X-Telegram-Bot-Api-Secret-Token)
# para que la API verifique que la llamada es legítima. Cámbialo por uno propio.
TELEGRAM_SECRET=cambiame

# ---- Despliegue ----
# URL pública https de la app (la de Heroku). Vacío hasta desplegar.
PUBLIC_URL=
